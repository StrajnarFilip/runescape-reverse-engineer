# Local research output, tools, caches and captures. Keep our own source scripts.
/work/*
!/work/*.py
!/work/decompile.ps1
!/work/ghidra_scripts/
/work/ghidra_scripts/*
!/work/ghidra_scripts/ExportFunctions.java

# Runtime output and Python bytecode
**/logs/
__pycache__/
*.py[cod]
*.log
*.jsonl
*.dmp
*.jcache
*.exe
*.msi
*.zip
*.gpr
*.rep/

# Credentials and local environment
.env
.env.*
!.env.example
*.pem
*.key
.venv/
venv/
.vscode/
.idea/

# Native build products and compiler caches
/build/
/outputs/
/.rsscan*/
/target/
CMakeUserPresets.json
rs3_catalog.bin
rs3_catalog.manifest.json
.zig-cache/
*.dll
*.obj
*.o
*.lib
*.a
*.pdb
*.class
