# Editor defaults shared by every language in the repository.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.{cmd,ps1}]
end_of_line = crlf

[*.{md,rst}]
trim_trailing_whitespace = false
